/target/

# The UU Remote analysis stays on this PC only (decompiled NetEase code, dumps, extracted interface text). The
# repository holds our own design notes (research\uu\*FINDINGS.md) and our own tools, never third-party material:
# everything else in research\uu is ignored.
/research/uu/*
!/research/uu/FINDINGS.md
!/research/uu/STREAMER_FINDINGS.md

# The Android app's build output, and the core libraries scripts/build_android.sh builds into it.
/mobile/android/.gradle/
/mobile/android/.kotlin/
/mobile/android/build/
/mobile/android/app/build/
/mobile/android/app/src/main/jniLibs/
/mobile/android/local.properties
# The iOS app's generated project, the core's xcframework and Info.plist (XcodeGen makes it from project.yml).
/mobile/ios/build/
/mobile/ios/Queqiao.xcodeproj/
/mobile/ios/Queqiao/Info.plist
